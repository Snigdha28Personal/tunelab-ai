# TuneLab Environment Variables Example
# Copy this file to .env or .env.local for local development

# Mode settings
DEMO_MODE=true

# Python Backend API URL (for local Next.js frontend to backend connection)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# OpenAI API Key (Optional — platform falls back to Python DEMO MODE if absent)
OPENAI_API_KEY=

# Supabase Credentials (Optional — for experiment history persistence)
SUPABASE_URL=
SUPABASE_ANON_KEY=
